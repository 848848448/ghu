# Copy this file to `.env` and fill in your own private values.
# The real `.env` is ignored by git and is NEVER uploaded to GitHub.
# Your secrets stay on your machine / server only.

# GraphQL API URL (was API_URL in the original script)
API_URL=

# Audio download endpoint base URL (was AUDIO_API_BASE)
AUDIO_API_BASE=

# Your JWT token (was USER_TOKEN)
USER_TOKEN=
