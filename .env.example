# Copy this file to `.env` and fill in your own private values.
# The real `.env` is ignored by git and is NEVER uploaded to GitHub.
# Your secrets stay on your machine / server only.

# GraphQL API URL (was API_URL in the original script)
API_URL=

# Audio download endpoint base URL (was AUDIO_API_BASE)
AUDIO_API_BASE=

# Your JWT token (was USER_TOKEN).
# Optional if you use auto-login below instead.
USER_TOKEN=

# --- Optional: automatic login (so the token never has to be updated) ---
# When these are set, the app logs in by itself and refreshes the token.
# Requires an email + password login on your account.
ZING_EMAIL=
ZING_PASSWORD=

# --- Optional: Firebase auto-refresh (for Google/Apple logins) ---
# Best option when the token comes from Firebase (issuer securetoken.google.com).
# The server exchanges the long-lived refresh token for fresh tokens forever.
FIREBASE_API_KEY=
FIREBASE_REFRESH_TOKEN=
